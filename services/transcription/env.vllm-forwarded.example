# Local adapter config for an SSM-forwarded AWS-hosted Voxtral vLLM runtime.
#
# Keep the SSM port forward open on the same machine that runs this service:
#
# aws ssm start-session \
#   --profile strln \
#   --region us-west-2 \
#   --target i-02b84c39f9912a77a \
#   --document-name AWS-StartPortForwardingSession \
#   --parameters '{"portNumber":["8000"],"localPortNumber":["8000"]}'
#
# Cubicle should connect to this service's WebSocket endpoint, usually:
#   ws://127.0.0.1:8080/v1/transcription
# The service then connects to the OpenAI-compatible vLLM endpoint below.

# Prefer TRANSCRIPTION_SERVICE_TOKEN_FILE for local launches so the bearer token
# is not exposed in shell history or process environment. Fall back to
# TRANSCRIPTION_SERVICE_TOKEN only for disposable dev-token testing.
# TRANSCRIPTION_SERVICE_TOKEN_FILE=/path/to/0600-token-file
TRANSCRIPTION_SERVICE_TOKEN=dev-token
TRANSCRIPTION_ASR_PROVIDER=voxtral_self_hosted
TRANSCRIPTION_DIARIZATION_PROVIDER=mock
TRANSCRIPTION_VOXTRAL_RUNTIME=vllm
TRANSCRIPTION_VOXTRAL_MODEL_VERSION=self-hosted-vllm-2602
TRANSCRIPTION_REQUIRE_GPU=false
TRANSCRIPTION_RETENTION=disabled

VLLM_BASE_URL=http://localhost:8000
VLLM_REALTIME_URL=ws://localhost:8000/v1/realtime
VLLM_MODEL=mistralai/Voxtral-Mini-4B-Realtime-2602
