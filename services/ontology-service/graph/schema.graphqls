  measurementProductActionReady: Boolean!
  measurementGapCount: Int!
  measurementMissingLabelCount: Int!
  forecastReadinessState: String!
  forecastEtaReady: Boolean!
  decisionTargetEvaluationState: String!
  decisionTargetEvaluationCount: Int!
  productReadyDecisionTargetEvaluationCount: Int!
  sourceCoverageState: String!
  sourceCoverageLimitedCount: Int!
  sourceCoverageUnknownCount: Int!
  absenceClaimsAllowed: Boolean!
  responsibilityValidationCount: Int!
  automationSummary: String!
  recommendedFocus: String
  guardrailPacket: WorkProgramGuardrailPacket!
  sourceCoveragePacket: WorkProgramSourceCoveragePacket!
  measurementPacket: WorkInsightMeasurementPacket!
  automationReadiness: WorkProgramAutomationReadiness
  tpmFunctionReadiness: [WorkProgramTpmFunctionReadiness!]!
  decisionTargetReadiness: WorkDecisionTargetReadiness!
  decisionTargetEvaluations: [WorkDecisionTargetEvaluation!]!
  qualityGates: [WorkProgramBriefQualityGate!]!
  evidenceNeeds: [WorkProgramAutomationEvidenceNeed!]!
  responsibilities: [WorkResponsibility!]!
}

