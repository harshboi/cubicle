  generatedAt: String
  replacementState: String!
  autonomousActionReady: Boolean!
  humanReviewRequired: Boolean!
  totalFunctionCount: Int!
  readyFunctionCount: Int!
  supervisedFunctionCount: Int!
  blockedFunctionCount: Int!
  humanRequiredFunctionCount: Int!
  blockingGateCount: Int!
  failedCheckCount: Int!
  failedAdversarialCheckCount: Int!
