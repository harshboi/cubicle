schema {
  query: Query
}

"""
Cubicle serves bounded product packets, not raw Ent table dumps.
Each query keeps freshness, evidence, and claim gates visible at the API boundary.
"""
type Query {
  health: Health!
  workActions(limit: Int = 20, decisionState: String, actionState: String = "open", ownerKey: String, sourceInstance: String): [WorkAction!]!
  workProgramItems(limit: Int = 50, workstreamKey: String, programStatus: String, tpmBucket: String, ownerKey: String, sourceInstance: String): [WorkProgramItem!]!
  workProgramMilestonePacket(workstreamKey: String!, limit: Int = 50, sourceInstance: String): WorkProgramMilestonePacket!
  workProgramSummary(workstreamKey: String, sourceInstance: String): WorkProgramSummary!
  workProgramBrief(workstreamKey: String, sourceInstance: String): WorkProgramBrief!
  workProgramGraphBrief(workstreamKey: String!, sourceInstance: String, promptMode: String = "operating"): WorkProgramGraphBrief
  """
  Returns a TPM-facing graph packet without making generated WorkProgram rows
  claim authorities. Evidence and guardrail fields decide what can be stated.
  """
  workProgramGraphContext(workstreamKey: String!, itemLimit: Int = 20, actionLimit: Int = 20, edgeLimit: Int = 50, insightLimit: Int = 20, forecastLimit: Int = 20, evidenceLimit: Int = 50, traversalDepth: Int = 2, runKey: String, generatedAt: String, sourceInstance: String): WorkProgramGraphContext!
  """
  Traverses typed and OpenGraph associations under explicit depth/fanout limits.
  Source coverage decides whether missing edges can support absence claims.
  """
  boundedGraphContext(startObjectType: String!, startKey: String!, associationTypes: [String!], depth: Int = 2, limitPerObject: Int = 4): BoundedGraphContext!
  workProgramEvidenceNeeds(limit: Int = 50, workstreamKey: String, gateKey: String, evidenceKind: String, executionState: String, ownerKey: String, actionKey: String, actionState: String, sourceInstance: String): [WorkProgramAutomationEvidenceNeed!]!
  workResponsibilities(limit: Int = 50, subjectKind: String, subjectKey: String, partyKind: String, partyKey: String, responsibilityKind: String, responsibilityState: String, basisKind: String, sourceInstance: String): [WorkResponsibility!]!
  workProgramAttentionPacket(workstreamKey: String!, limit: Int = 20, evidenceLimit: Int = 50, sourceInstance: String): WorkProgramAttentionPacket!
  workProgramAutomationPlanPacket(workstreamKey: String!, actionState: String = "open", actionLimit: Int = 20, evidenceLimit: Int = 50, reviewLimit: Int = 20, sourceInstance: String): WorkProgramAutomationPlanPacket!
  workProgramExecutionPacket(workstreamKey: String!, actionState: String = "open", actionLimit: Int = 20, evidenceLimit: Int = 50, reviewLimit: Int = 20, sourceInstance: String): WorkProgramExecutionPacket!
  workProgramOwnerPacket(workstreamKey: String!, ownerKey: String!, actionState: String = "open", actionLimit: Int = 20, evidenceLimit: Int = 50, sourceInstance: String): WorkProgramOwnerPacket!
  workProgramBlockerPacket(workstreamKey: String!, blockerState: String = "open", limit: Int = 20, evidenceLimit: Int = 50, sourceInstance: String): WorkProgramBlockerPacket!
  workProgramForecastPacket(workstreamKey: String!, limit: Int = 20, evidenceLimit: Int = 50, sourceInstance: String): WorkProgramForecastPacket!
  workProgramGuardrailPacket(workstreamKey: String!, limit: Int = 20, evidenceLimit: Int = 50, sourceInstance: String): WorkProgramGuardrailPacket!
  workProgramSourceCoveragePacket(workstreamKey: String!, limit: Int = 50, evidenceLimit: Int = 50, sourceInstance: String): WorkProgramSourceCoveragePacket!
  workProgramTpmReadinessPacket(workstreamKey: String!, functionLimit: Int = 20, evidenceLimit: Int = 50, reviewLimit: Int = 20, sourceInstance: String): WorkProgramTpmReadinessPacket!
  workDecisionTargetEvaluations(limit: Int = 20, targetKind: String, evaluationKind: String, productActionGateState: String, sourceInstance: String): [WorkDecisionTargetEvaluation!]!
  workDecisionTargetReadiness(limit: Int = 20, sourceInstance: String): WorkDecisionTargetReadiness!
  workItemForecasts(limit: Int = 20, riskBand: String, subjectState: String = "open", sourceInstance: String!): [WorkItemForecast!]!
  forecastReadiness(sourceInstance: String!, actionState: String = "open"): WorkForecastReadiness!
  workItemStateSnapshots(subjectKind: String!, subjectKey: String!, limit: Int = 20, sourceInstance: String): [WorkItemStateSnapshot!]!
  workItemStateTransitions(limit: Int = 20, subjectKind: String, subjectKey: String, transitionKind: String, requiresCloseout: Boolean, sourceInstance: String): [WorkItemStateTransition!]!
  workActionSummary(actionState: String = "open", sourceInstance: String): WorkActionSummary!
  workInsightEvaluation(sourceInstance: String): WorkInsightEvaluation!
  workInsightMeasurementPacket(sourceInstance: String, reviewLimit: Int = 20, insightKind: String): WorkInsightMeasurementPacket!
  workInsightReviews(limit: Int = 50, sourceInstance: String, reviewState: String, reviewKind: String, insightKind: String, measurementEligible: Boolean): [WorkInsightReview!]!
  workstreams(limit: Int = 20, actionState: String = "open", sourceInstance: String): [WorkstreamRegister!]!
  ownerLoadSnapshots(limit: Int = 20, workstreamKey: String!, ownerKey: String, sourceInstance: String): [WorkOwnerLoadSnapshot!]!
  workstreamStandup(actionState: String = "open", sourceInstance: String): WorkstreamStandup!
  workstreamStandupSections(limit: Int = 30, workstreamKey: String, sectionKind: String, sourceInstance: String): [WorkstreamStandupSection!]!
  workstreamHealthSnapshots(limit: Int = 20, workstreamKey: String, sourceInstance: String): [WorkstreamHealthSnapshot!]!
  workLensWindows(limit: Int = 20, targetKind: String, lensKind: String, resultLimit: Int = 20): [WorkLensWindow!]!
  workBlockers(limit: Int = 20, blockerState: String = "open", subjectKind: String, subjectKey: String, sourceInstance: String): [WorkBlocker!]!
  workDependencyEdges(limit: Int = 100, fromKind: String, fromKey: String, edgeKind: String, sourceInstance: String): [WorkDependencyEdge!]!
  workBlockerImpacts(limit: Int = 20, impactState: String = "open", affectedKind: String, affectedKey: String, workstreamKey: String, sourceInstance: String): [WorkBlockerImpact!]!
}

type Health {
  ok: Boolean!
  service: String!
}

"""
Durable follow-up ledger for generated and source-backed operating signals.
Actions carry decision gates so an insight does not become product action by accident.
"""
type WorkAction {
  key: ID!
  sourceInstance: String
  actionType: String!
  actionState: String!
  decisionState: String!
  decision: String
  decisionReason: String
  subjectKind: String!
  subjectKey: String!
  subjectTitle: String
  subjectUrl: String
  relatedTicketKeys: [String!]!
  relatedPullRequestKeys: [String!]!
  ownerKey: String
  ownerSource: String
  dueBucket: String!
  rankScore: Float!
  sourceUrl: String
  decisionNeeded: String
  recommendedAction: String
  claimUse: String!
  claimGateReason: String!
  productActionAllowed: Boolean!
  absenceClaimAllowed: Boolean!
  etaClaimAllowed: Boolean!
  evidenceRef: String
  evidence: WorkEvidenceSummary
  badges: [WorkActionBadge!]!
  observations: [WorkActionObservation!]!
  sourceInsights: [WorkInsightSummary!]!
}

type WorkActionSummary {
  sourceInstance: String
  actionState: String!
  totalCount: Int!
  productActionCount: Int!
  validationLeadCount: Int!
  sourceRepairCount: Int!
  closeoutReviewCount: Int!
  modelOrRuleQaCount: Int!
  suppressedSignalCount: Int!
  nowCount: Int!
  thisWeekCount: Int!
  watchCount: Int!
  unscheduledCount: Int!
  highPriorityCount: Int!
  supportsActionObservationCount: Int!
  badges: [WorkActionBadge!]!
  breakdowns: [WorkActionBreakdown!]!
  ownerRollups: [WorkActionOwnerRollup!]!
  forecastReadiness: WorkForecastReadiness!
  topActions: [WorkAction!]!
}

"""
WorkProgramItem is the workstream register row that TPM views page over.
It references product work while keeping generated status and claim gates separate.
"""
type WorkProgramItem {
  key: ID!
  sourceInstance: String
  workstreamKey: String!
  subjectKind: String!
  subjectObjectType: String
  subjectKey: String!
  linkedTicketKeys: [String!]!
  linkedPullRequestKeys: [String!]!
  title: String!
  programStatus: String!
  tpmBucket: String!
  ownerKey: String
  ownerSource: String
  authorDri: String
  requestedReviewerKeys: [String!]!
  reviewerOrApprover: String
  nextAction: String
  decisionNeeded: String
  decisionState: String!
  decisionGateReason: String
  claimUse: String!
  claimGateReason: String!
  productActionAllowed: Boolean!
  absenceClaimAllowed: Boolean!
  etaClaimAllowed: Boolean!
  dueBucket: String!
  lastSourceUpdateAt: String
  ageDays: Float
  staleDays: Float
  riskScore: Float!
  blockerLabelState: String
  ciSignal: String
  transitionState: String
  dependencySummary: String
  sourceCoverageState: String
  labelQuality: String
  evidenceRef: String
  evidence: WorkEvidenceSummary
  badges: [WorkActionBadge!]!
  action: WorkAction
  links: [WorkProgramItemLink!]!
}

"""
Structured adjacency for a WorkProgramItem.
Display key lists remain UI hints; these rows are the traversable relationships.
"""
type WorkProgramItemLink {
  key: ID!
  sourceInstance: String
  linkKind: String!
  targetObjectType: String!
  targetKey: String!
  targetResolutionState: String!
  linkSummary: String
  linkSource: String
  evidenceRef: String
  evidence: WorkEvidenceSummary
  freshnessState: String!
  visibility: String!
  confidence: Float!
  rankScore: Float!
}

"""
Responsibility rows model accountable parties with evidence and basis.
They avoid hiding ownership inside free-form owner_key text.
"""
type WorkResponsibility {
  key: ID!
  sourceInstance: String
  workstreamKey: String
  subjectKind: String!
  subjectKey: String!
  subjectTitle: String
  subjectUrl: String
  partyKind: String!
  partyKey: String!
  partySource: String
  personKey: String
  personDisplayName: String
  responsibilityKind: String!
  basisKind: String!
  basisDetail: String
  responsibilityState: String!
  responsibilityStateReason: String
  sourceUrl: String
  evidenceRef: String
  evidence: WorkEvidenceSummary
  freshnessState: String!
  visibility: String!
  confidence: Float!
  rankScore: Float!
  badges: [WorkActionBadge!]!
  action: WorkAction
  blocker: WorkBlocker
  programItem: WorkProgramItem
  evidenceNeed: WorkProgramAutomationEvidenceNeed
}

