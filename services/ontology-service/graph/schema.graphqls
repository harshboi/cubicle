"""
Graph context is the prompt/building-block DTO for AI summaries.
The server decides which rows are evidence, guardrails, or non-claimable diagnostics.
"""
type WorkProgramGraphContext {
  sourceInstance: String
  generatedAt: String
  scopeMode: String!
  runKey: String
  workstreamKey: String!
  contextHash: String!
  traversalDepth: Int!
  itemCount: Int!
  actionCount: Int!
  dependencyEdgeCount: Int!
  insightCount: Int!
  forecastCount: Int!
  graphSummary: String!
  llmTask: String!
  reachedSubjectKeys: [String!]!
  allowedCitations: [String!]!
  citations: [WorkGraphCitation!]!
  items: [WorkProgramItem!]!
  actions: [WorkAction!]!
  dependencyEdges: [WorkDependencyEdge!]!
  insights: [WorkInsightSummary!]!
  forecasts: [WorkItemForecast!]!
  qualityGates: [WorkProgramBriefQualityGate!]!
  evidenceNeeds: [WorkProgramAutomationEvidenceNeed!]!
  forecastPacket: WorkProgramForecastPacket!
  guardrailPacket: WorkProgramGuardrailPacket!
  sourceCoveragePacket: WorkProgramSourceCoveragePacket!
  badges: [WorkActionBadge!]!
}

"""
Generic bounded traversal output for connectors that have not earned typed schemas.
Callers must inspect coverage and evidence before making product claims.
"""
type BoundedGraphContext {
  contextHash: String!
  seed: BoundedGraphRef!
  depth: Int!
  limitPerObject: Int!
  scopeMode: String!
  coverage: BoundedGraphCoverage!
  guardrails: [String!]!
  objects: [BoundedGraphObject!]!
  associations: [BoundedGraphAssociation!]!
  evidence: [BoundedGraphEvidence!]!
}

type BoundedGraphRef {
  objectType: String!
  key: String!
}

"""
Coverage explains what the traversal was allowed to see.
Sparse or stale coverage keeps absence claims out of product answers.
"""
type BoundedGraphCoverage {
  coverageState: String!
  absenceClaimsAllowed: Boolean!
  absenceClaimGateReason: String!
  absenceClaimAssociationTypes: [String!]!
  sourceSystem: String
  sourceInstance: String
  coverageWindowStart: String
  coverageWindowEnd: String
  summary: String
}

type BoundedGraphObject {
  objectType: String!
  key: String!
  title: String!
  source: String
  sourceInstance: String
  externalID: String
  visibility: String
  freshnessState: String
