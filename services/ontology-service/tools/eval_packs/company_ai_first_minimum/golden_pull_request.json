{
  "name": "company-ai-first-minimum-pull-request",
  "required_categories": [
    "ticket-pr",
    "pr-author",
    "pr-approver",
    "sparse-coverage"
  ],
  "required_source_coverage_states": [
    "sparse"
  ],
  "questions": [
    {
      "key": "pull-request:ticket-pr",
      "category": "ticket-pr",
      "source_coverage_state": "sparse",
      "question": "Does the answer cite the ticket-to-PR implementation relationship?",
      "expected_facts": [
        {
          "text": "ticket:COMP-101` -> `pull-request:company/app#42",
          "citation_prefix": "[graph_associations:"
        },
        {
          "text": "implemented_by",
          "citation_prefix": "[graph_associations:"
        }
      ]
    },
    {
      "key": "pull-request:author",
      "category": "pr-author",
      "source_coverage_state": "sparse",
      "question": "Does the answer cite Alice as PR author?",
      "expected_facts": [
        {
          "text": "pull-request:company/app#42` -> `person:alice",
          "citation_prefix": "[graph_associations:"
        },
        {
          "text": "author",
          "citation_prefix": "[graph_associations:"
        }
      ]
    },
    {
      "key": "pull-request:approver",
      "category": "pr-approver",
      "source_coverage_state": "sparse",
      "question": "Does the answer cite Bob as PR approver?",
      "expected_facts": [
        {
          "text": "pull-request:company/app#42` -> `person:bob",
          "citation_prefix": "[graph_associations:"
        },
        {
          "text": "approver",
          "citation_prefix": "[graph_associations:"
        }
      ]
    },
    {
      "key": "pull-request:sparse-coverage",
      "category": "sparse-coverage",
      "source_coverage_state": "sparse",
      "question": "Does sparse coverage block absence claims?",
      "expected_facts": [
        {
          "text": "missing neighbors are unknown, not absent",
          "citation_prefix": "[guardrail:"
        }
      ],
      "forbidden_phrases": [
        "no reviewers",
        "no approvers",
        "coverage is complete",
        "WorkProgram",
        "TPM",
        "Flink"
      ]
    }
  ]
}
